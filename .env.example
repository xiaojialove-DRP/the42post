# ═══════════════════════════════════════════════════════
# THE 42 POST — Environment Configuration
# Copy this file to .env and fill in actual values
# ═══════════════════════════════════════════════════════

# DATABASE
# For PostgreSQL (Railway default):
DATABASE_URL=postgresql://user:password@host:5432/42post_db
# For SQLite (local development):
# DATABASE_URL=sqlite:./data/42post.db

# AUTHENTICATION
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_recommended_change_in_production
JWT_EXPIRY=24h

# SKILL GENERATION — DeepSeek is the primary provider, required for forge
# generation and Twin Test to produce real (non-template) output.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# Optional: DEEPSEEK_MODEL=deepseek-chat

# CLAUDE API — optional automatic fallback, used only when DeepSeek is
# unreachable (outage, quota, rate limit). Leave unset/commented to skip it
# and degrade straight to the static template fallback instead.
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# Optional: ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# SIGNING & SECURITY
SIGNING_SECRET=your_hmac_signing_secret_minimum_32_characters_change_in_production

# SERVER
PORT=3000
NODE_ENV=development
# In production (Railway), set to your Railway domain:
# FRONTEND_URL=https://yourapp-production.up.railway.app
FRONTEND_URL=http://localhost:8000

# EMAIL (optional — forge success + creator digest emails are skipped,
# not broken, when this is unset; logged to console instead)
# Railway blocks outbound SMTP ports (25/465/587), so this uses Resend's
# HTTPS API instead of SMTP. Get a key at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key
# Optional: EMAIL_FROM=onboarding@resend.dev, EMAIL_FROM_NAME=THE 42 POST

# LOGGING
LOG_LEVEL=info
