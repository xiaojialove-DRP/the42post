# Database
# Local dev: leave this unset — defaults to a local SQLite file, zero config.
# Production: Zeabur auto-injects POSTGRES_URI. DATABASE_URL also works as a fallback alias.
# POSTGRES_URI=postgresql://postgres:password@localhost:5432/42post_db

# Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_recommended
JWT_EXPIRY=24h

# LLM Provider Configuration
# DeepSeek is the primary provider, required for real Skill/Twin Test generation.
# Without it the app still runs, but falls back to template-based generation.
DEEPSEEK_API_KEY=your_deepseek_api_key
# Optional: DEEPSEEK_MODEL=deepseek-chat

# Anthropic Claude (https://console.anthropic.com/keys)
# Optional fallback, only called if the DeepSeek request fails. Leave unset to skip it.
# ANTHROPIC_API_KEY=your_claude_api_key
# Optional: ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Signing & Security
SIGNING_SECRET=your_hmac_signing_secret_minimum_32_characters

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:8000

# Email — Resend (HTTP API; Zeabur blocks SMTP)
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# Optional: "From" address. Defaults to onboarding@resend.dev (Resend's test
# sender, no domain verification needed). For production, verify your own
# domain in Resend and set this to e.g. noreply@yourdomain.com
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=THE 42 POST
