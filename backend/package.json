{
  "name": "42post-backend",
  "version": "0.1.0",
  "description": "THE 42 POST — Backend (内胆) for AI value alignment skills",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "better-sqlite3": "^12.9.0",
    "compression": "^1.8.1",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "jsonwebtoken": "9.0.2",
    "pg": "8.11.2",
    "resend": "^6.12.2",
    "uuid": "9.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.5"
  },
  "vitest": {
    "environment": "node",
    "testMatch": [
      "./test/**/*.test.js"
    ],
    "coverage": {
      "provider": "v8",
      "reporter": [
        "text",
        "html"
      ],
      "include": [
        "routes/**/*.js",
        "utils/**/*.js"
      ]
    }
  }
}
