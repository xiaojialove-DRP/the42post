# Dependencies
# package-lock.json is intentionally NOT ignored - this is an application,
# not a library, so the lockfile is committed to pin exact dependency
# versions across every machine and CI run. npm ci (used in CI) requires
# it to exist in the repo.
node_modules/
yarn.lock

# Environment
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Testing
coverage/
.nyc_output/

# Build
dist/
build/
